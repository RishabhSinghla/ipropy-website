# Server-only — never exposed to the browser (see lib/crm-client.ts).
CRM_API_URL=http://localhost:4000
ENQUIRY_FORM_KEY=website-enquiry

# Public — the browser fetches gallery/floor-plan images directly from this
# host (see lib/media.ts), so it's inlined into the client bundle by design.
NEXT_PUBLIC_CRM_MEDIA_URL=http://localhost:4000

# Public — used to build absolute URLs in sitemap.xml/robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. The business WhatsApp number, digits with country code
# (e.g. 919876543210). Unset, no WhatsApp button is shown.
NEXT_PUBLIC_WHATSAPP_NUMBER=
